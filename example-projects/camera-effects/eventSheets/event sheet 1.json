{
	"name": "Event sheet 1",
	"events": [
		{
			"eventType": "comment",
			"text": "Request a camera feed when clicking the Camera button."
		},
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-clicked",
					"objectClass": "GetCamera",
					"sid": 267940042167711
				}
			],
			"actions": [
				{
					"id": "request-camera",
					"objectClass": "UserMedia",
					"sid": 610436091581226,
					"parameters": {
						"source": "0",
						"preferred-direction": "any",
						"preferred-width": "0",
						"preferred-height": "0",
						"include-mic": false,
						"mic-source": "0"
					}
				}
			],
			"sid": 663848259118304
		},
		{
			"eventType": "comment",
			"text": "Change the status depending on if the user approved or declined the request."
		},
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-media-request-approved",
					"objectClass": "UserMedia",
					"sid": 721137586823026
				}
			],
			"actions": [
				{
					"id": "set-text",
					"objectClass": "StatusText",
					"sid": 312822829240137,
					"parameters": {
						"text": "\"Approved!\""
					}
				},
				{
					"id": "set-enabled",
					"objectClass": "StopCamera",
					"sid": 749250614761466,
					"parameters": {
						"mode": "enabled"
					}
				},
				{
					"id": "set-enabled",
					"objectClass": "GetCamera",
					"sid": 674932165277856,
					"parameters": {
						"mode": "disabled"
					}
				}
			],
			"sid": 926402049416286
		},
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-media-request-declined",
					"objectClass": "UserMedia",
					"sid": 277291305915596
				}
			],
			"actions": [
				{
					"id": "set-text",
					"objectClass": "StatusText",
					"sid": 368450352350296,
					"parameters": {
						"text": "\"Declined!\""
					}
				}
			],
			"sid": 117103199766547
		},
		{
			"eventType": "comment",
			"text": "Show the dimensions of the source video feed."
		},
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "every-tick",
					"objectClass": "System",
					"sid": 659025202776730
				}
			],
			"actions": [
				{
					"id": "set-text",
					"objectClass": "VideoSizeText",
					"sid": 798998525293443,
					"parameters": {
						"text": "UserMedia.VideoWidth & \" x \" & UserMedia.VideoHeight"
					}
				}
			],
			"sid": 852737931564929
		},
