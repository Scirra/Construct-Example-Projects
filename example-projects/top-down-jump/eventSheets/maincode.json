		{
			"eventType": "group",
			"disabled": false,
			"title": "Camera",
			"description": "",
			"isActiveOnStart": true,
			"children": [
				{
					"eventType": "comment",
					"text": "The current angle of movement for the player."
				},
				{
					"eventType": "variable",
					"name": "AngleOfMovement",
					"type": "number",
					"initialValue": "0",
					"comment": "",
					"isStatic": true,
					"isConstant": false,
					"sid": 811624744253342
				},
				{
					"eventType": "comment",
					"text": "Store the latest angle of movement in a variable while the player is moving. It's important to store this value somewhere, because the native moving angle resets to zero if the player is not moving anymore, resulting in a very weird camera scrolling animation."
				},
				{
					"eventType": "block",
					"conditions": [
						{
							"id": "is-moving",
							"objectClass": "PlayerCollision",
							"sid": 324894239036921,
							"behaviorType": "8Direction"
						}
					],
					"actions": [
						{
							"id": "set-eventvar-value",
							"objectClass": "System",
							"sid": 597543108584644,
							"parameters": {
								"variable": "AngleOfMovement",
								"value": "PlayerCollision.8Direction.MovingAngle"
							}
						}
					],
					"sid": 958014473521214
				},
				{
					"eventType": "comment",
					"text": "How far the camera will be from the player."
				},
				{
					"eventType": "variable",
					"name": "DISTANCEFROMPLAYER",
					"type": "number",
					"initialValue": "64",
					"comment": "",
					"isStatic": false,
					"isConstant": true,
					"sid": 808973081705556
				},
				{
					"eventType": "comment",
					"text": "How fast the camera will adjust itself to match the player angle of movement."
				},
				{
					"eventType": "variable",
					"name": "STEPSIZE",
					"type": "number",
					"initialValue": "0.1",
					"comment": "",
					"isStatic": false,
					"isConstant": true,
					"sid": 966510128161020
				},
				{
					"eventType": "comment",
					"text": "The camera starts above the player."
				},
				{
					"eventType": "block",
					"conditions": [
						{
							"id": "on-start-of-layout",
							"objectClass": "System",
							"sid": 314978239578018
						}
					],
					"actions": [
						{
							"id": "scroll-to-position",
							"objectClass": "System",
							"sid": 662929391070266,
							"parameters": {
								"x": "PlayerCollision.X + cos(AngleOfMovement) * DISTANCEFROMPLAYER",
								"y": "PlayerCollision.Y + sin(AngleOfMovement) * DISTANCEFROMPLAYER / 2"
							}
						}
					],
					"sid": 176819595284570
				},
				{
					"eventType": "comment",
					"text": "Constantly update the camera position to be in front of the player."
				},
				{
					"eventType": "block",
					"conditions": [
						{
							"id": "every-tick",
							"objectClass": "System",
							"sid": 858683945528946
						}
					],
					"actions": [
						{
							"id": "scroll-to-x",
							"objectClass": "System",
							"sid": 118598801749801,
							"parameters": {
								"x": "lerp(scrollx, PlayerCollision.X + cos(AngleOfMovement) * DISTANCEFROMPLAYER, STEPSIZE * 60 * dt)"
							}
						},
						{
							"id": "scroll-to-y",
							"objectClass": "System",
							"sid": 158476389368246,
							"parameters": {
								"y": "lerp(scrolly, PlayerCollision.Y + sin(AngleOfMovement) * DISTANCEFROMPLAYER / 2, STEPSIZE * 60 * dt) + GameManager.Sine.Value"
							}
						}
					],
					"sid": 558548756168901
				}
			],
			"sid": 785034104595965
		},
